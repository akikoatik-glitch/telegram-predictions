# ─── Telegram (REQUIRED) ─────────────────────────────
# Token from @BotFather. Bot must be ADMIN of your channel/group.
TELEGRAM_BOT_TOKEN=
# Channel/group chat id, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# ─── Data (NO key needed by default) ───────────────────
# Free datasets cover all 10 first divisions + Championship automatically:
# openfootball (8 leagues) + belgium txt + ESPN (Turkish/Saudi + extras).
# Optional upgrade: free api-football.com key switches covered leagues to
# exact-UTC standings data and unlocks UCL/UEL.
API_FOOTBALL_KEY=

# ─── Behaviour (all tunable, no code changes) ──────────
SEASON=2026-27
LANG=both
DISPLAY_TZ=Africa/Algiers
PREDICTION_MINUTES_BEFORE_KICKOFF=15
WINDOW_SPREAD=7
MIN_CONFIDENCE=60
MAX_POSTS_PER_DAY=15
PAUSED=false
DRY_RUN=false
