# ─── Telegram (REQUIRED) ─────────────────────────────
# Token from @BotFather. Bot must be ADMIN of your group.
TELEGRAM_BOT_TOKEN=
# Group chat id, e.g. -1001234567890 (use @userinfobot inside the group)
TELEGRAM_CHAT_ID=

# ─── Football data (NO key needed by default) ──────────
# Free openfootball dataset is used automatically. Optional upgrade:
# paste a free api-football.com key for 10 leagues incl. UCL/UEL.
API_FOOTBALL_KEY=

# ─── Schedule / behaviour (sane defaults) ──────────────
SEASON=2025
LEAD_MINUTES_MIN=45
LEAD_MINUTES_MAX=240
MAX_POSTS_PER_DAY=15
MIN_CONFIDENCE=55
DRY_RUN=false
