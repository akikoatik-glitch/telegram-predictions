# ─── Telegram (REQUIRED) ─────────────────────────────
# Token from @BotFather. Bot must be ADMIN of your channel/group.
TELEGRAM_BOT_TOKEN=
# Channel/group chat id, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# ─── Data (NO key needed by default) ───────────────────
# Free openfootball dataset is used automatically (7 leagues, 2026-27).
# Optional upgrade: free api-football.com key unlocks all 10 leagues
# (Belgian + Turkish + Saudi) plus UCL/UEL and exact odds/xG later.
API_FOOTBALL_KEY=

# ─── Behaviour (all tunable, no code changes) ──────────
SEASON=2026-27
LANG=both
PREDICTION_MINUTES_BEFORE_KICKOFF=15
WINDOW_SPREAD=7
MIN_CONFIDENCE=60
MAX_POSTS_PER_DAY=15
PAUSED=false
DRY_RUN=false
